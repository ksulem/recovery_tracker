# Telegram bot token from @BotFather. A NEW bot — not the watering bot's token.
BOT_TOKEN=

# Your numeric Telegram user id. The bot silently ignores everyone else.
OWNER_USER_ID=

# Password of the recovery_app role (see scripts/create_db.sql).
# docker-compose.yml builds DATABASE_URL from it, pointing at the
# watering-system Postgres container over the shared "pg-shared" network.
RECOVERY_DB_PASSWORD=

# Only for running outside Docker (local development with a local Postgres).
# DATABASE_URL=postgresql+asyncpg://recovery_app:password@127.0.0.1:5432/recovery

LOG_LEVEL=INFO

# Timezone used until onboarding sets yours (IANA name, e.g. Asia/Tbilisi).
DEFAULT_TIMEZONE=UTC
