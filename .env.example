# Copy this file to .env and fill in the values. Never commit .env.
# Every name starts with RECOVERY_ so nothing clashes with other projects
# running on the same machine.

# --- Required ---------------------------------------------------------------

# Token of YOUR bot, from @BotFather in Telegram (/newbot). Looks like 123456:ABC-...
RECOVERY_BOT_TOKEN=

# Your numeric Telegram user id (e.g. ask @userinfobot). The bot answers only
# this account and silently ignores everyone else.
RECOVERY_OWNER_USER_ID=

# Password for the bot's database. Letters and digits only (it goes into a URL).
# Generate one with:  openssl rand -hex 16
RECOVERY_DB_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Timezone used until you pick yours in /start (IANA name, e.g. Europe/Berlin).
RECOVERY_DEFAULT_TIMEZONE=UTC

# Emergency number shown if a message suggests immediate danger.
# 112 works across the EU and many other countries; use your local one.
RECOVERY_EMERGENCY_NUMBER=112

RECOVERY_LOG_LEVEL=INFO

# --- Only for special setups --------------------------------------------------

# Reuse Postgres from ANOTHER Compose project on the same server instead of
# running our own (see docs/DEPLOY_SHARED_POSTGRES.md):
# COMPOSE_FILE=docker-compose.shared.yml
# RECOVERY_PG_NETWORK=plant-monitor_default   # that project's Docker network
# RECOVERY_PG_HOST=timescaledb                # its Postgres service name

# Running the bot outside Docker (local development with your own Postgres):
# RECOVERY_DATABASE_URL=postgresql+asyncpg://recovery_app:password@127.0.0.1:5432/recovery
