# Recovery Companion — lives in its OWN directory on the VM (e.g. /opt/recovery/.env),
# never in watering-system's .env. Every name is prefixed with RECOVERY_ so the
# watering variables (BOT_TOKEN, OWNER_USER_ID, DATABASE_URL, ...) can't leak in.

# Token of the recovery bot from @BotFather — NOT the watering bot's token.
# (The bot refuses to start if the token has a webhook, i.e. looks like the watering bot.)
RECOVERY_BOT_TOKEN=

# Your numeric Telegram user id. The bot silently ignores everyone else.
RECOVERY_OWNER_USER_ID=

# Password of the recovery_app role (see scripts/create_db.sql).
# docker-compose.yml builds the database URL from it.
RECOVERY_DB_PASSWORD=

# Existing Docker network of the watering-system stack, joined read-only from our
# side (nothing in watering-system is changed). Check with: docker network ls
RECOVERY_PG_NETWORK=plant-monitor_default
# Postgres service name on that network.
RECOVERY_PG_HOST=timescaledb

RECOVERY_LOG_LEVEL=INFO

# Timezone used until onboarding sets yours (IANA name, e.g. Asia/Tbilisi).
RECOVERY_DEFAULT_TIMEZONE=UTC

# Only for running outside Docker (local development with a local Postgres).
# RECOVERY_DATABASE_URL=postgresql+asyncpg://recovery_app:password@127.0.0.1:5432/recovery
